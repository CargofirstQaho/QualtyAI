# QualtyAI Web Frontend — Environment Configuration

# Base URL of the backend Express API (optional in standalone mode)
# In production, set this to your hosted backend API URL (e.g., on Render, Railway, AWS, or Fly.io)
NEXT_PUBLIC_API_URL=http://localhost:3214

# Public site URL (for canonical tags and metadata)
NEXT_PUBLIC_SITE_URL=https://qualty.ai

# Optional: Google / Analytics tracking IDs
# NEXT_PUBLIC_ANALYTICS_ID=
